{
  "name": "fmcg-distributor-control-system",
  "version": "6.0.0",
  "description": "FMCG Distributor Control System — a security-hardened ERP for distributors. Self-hosted edition (Node.js + Express + SQLite) and a cloud edition (MongoDB) deployable to Vercel.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node scripts/run-security-tests.js",
    "test:security": "node tests/security.test.js",
    "check": "node scripts/check-syntax.js",
    "lint": "node scripts/check-syntax.js",
    "build:client": "cd client && npm run build",
    "cloud:dev": "concurrently \"cd server && npm run dev\" \"cd client && npm run dev\"",
    "cloud:start": "cd server && npm start",
    "cloud:seed": "cd server && npm run seed",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "features": {
    "security": [
      "24-layer security middleware",
      "CSP with nonces (no unsafe-inline)",
      "TOTP-based 2FA for admins",
      "Security event notifications",
      "46 automated security tests (100% passing)"
    ],
    "business": [
      "Reports & PDF Export",
      "Purchase Orders Management",
      "Invoice Generation",
      "Inventory Alerts System",
      "Payment Reminders",
      "Sales Targets Tracking",
      "Returns Management",
      "Data Backup & Restore",
      "Dashboard Charts (Chart.js)",
      "WhatsApp Integration",
      "Mobile Responsive UI"
    ]
  },
  "keywords": [
    "fmcg",
    "distributor",
    "control-system",
    "erp",
    "inventory",
    "sales"
  ],
  "author": "Sayak Satpathi",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "validator": "^13.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.0"
  }
}
